---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const formatDate = (date: Date) =>
	date.toLocaleDateString("tr-TR", { day: "2-digit", month: "long", year: "numeric" });
---

<Base title="Blog — cantaproje" description="Ruhsat, proje ve işletme süreçleri üzerine kısa notlar.">
	<section>
		<p class="text-xs font-black uppercase tracking-[0.2em] text-primary">Blog</p>
		<h1 class="mt-3 text-4xl font-black tracking-[-0.04em] text-foreground sm:text-5xl">
			Ruhsat ve işletme notları.
		</h1>
		<p class="mt-5 max-w-2xl text-base leading-relaxed text-muted-foreground">
			Çanta atölyesi kuranlar için mevzuat, dosya hazırlığı ve işletme kayıtları üzerine yazılar.
		</p>
	</section>

	<div class="mt-12 divide-y divide-border border-t border-border">
		{
			posts.length === 0 ? (
				<p class="py-8 text-sm text-muted-foreground">Henüz yayınlanmış yazı yok.</p>
			) : (
				posts.map((post) => (
					<a class="block py-6 hover:bg-muted/40" href={`${base}/blog/${post.id}/`}>
						<div class="flex flex-wrap items-center gap-3 text-xs font-semibold uppercase tracking-wider text-muted-foreground">
							<span class="font-mono text-primary">{formatDate(post.data.pubDate)}</span>
							{post.data.tags.slice(0, 2).map((tag) => (
								<span>{tag}</span>
							))}
						</div>
						<h2 class="mt-3 text-xl font-bold tracking-tight text-foreground">{post.data.title}</h2>
						<p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted-foreground">{post.data.description}</p>
					</a>
				))
			)
		}
	</div>
</Base>
